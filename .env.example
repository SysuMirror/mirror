# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交密钥。
# server.py 启动时会自动读取项目根目录下的 .env（已存在则不覆盖环境变量）。

# ---- UniSSO 登录（必需，缺失时登录接口会明确报错）----
UNISSO_ISSUER=https://sso.ssemarket.cn
UNISSO_CLIENT_ID=
UNISSO_CLIENT_SECRET=

# ---- 集市主站（订单转发用）----
MARKET_BASE=https://ssemarket.cn
MARKET_TRUST_SECRET=
MARKET_OFFICIAL_EMAIL=
MARKET_OFFICIAL_PASSWORD=
MARKET_OFFICIAL_NAME=软工集市官方

# ---- 服务监听端口（平台会注入 PORT=8080，本地默认同值）----
PORT=8080
